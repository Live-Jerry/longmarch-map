+
+        // 初始化控制栏
+        initControls();
+
+        // 初始化认证状态（updateAuthUI 会自动处理管理按钮显示）
+        initAuth();
+
+        // 隐藏加载封面
+        window.addEventListener("load", () => {
+            setTimeout(() => {
+                const overlay = document.getElementById("loading-overlay");
+                if (overlay) {
+                    overlay.classList.add("fade-out");
+                    setTimeout(() => overlay.remove(), 700);
+                }
+            }, 800);
+        });
+
+        // 键盘快捷键
+        document.addEventListener("keydown", (e) => {
+            // ESC 关闭面板
+            if (e.key === "Escape") {
+                closeNodePanel();
+                document.getElementById("message-board")?.classList.remove("visible");
+                document.getElementById("army-selector")?.classList.remove("visible");
+            }
+            // 左右方向键切换步骤
+            if (document.getElementById("info-panel").classList.contains("visible")) {
+                if (e.key === "ArrowRight") nextStep();
+                if (e.key === "ArrowLeft")  prevStep();
+            }
+        });
+
+        console.log("[App] 长征文化数字地图初始化完成");
+    })();
+    </script>
+</body>
