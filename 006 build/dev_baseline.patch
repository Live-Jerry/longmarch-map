+}
+
+.version-badge.version-dev {
+    background: rgba(243, 156, 18, 0.2);
+    color: #f1c40f;
+    border: 1px solid rgba(243, 156, 18, 0.4);
+}
+
+.version-badge .version-env {
+    margin-left: 4px;
+    text-transform: uppercase;
+}
+
+@media (max-width: 768px) {
+    #info-panel {
+        width: calc(100vw - 32px);
+        max-width: calc(100vw - 32px);
+        min-width: unset;
+        left: 16px;
+        right: 16px;
+        top: auto;
+        bottom: 100px;
+        max-height: 50vh;
+    }
+
+    #controls {
+        top: auto;
+        bottom: 12px;
+        right: 12px;
+        flex-direction: row;
+        gap: 6px;
+        padding: 8px 12px;
+    }
+
+    #play-controls {
+        flex-direction: row;
+    }
+
+    .ctrl-btn {
+        min-width: 60px;
+        padding: 9px 9px;
+        font-size: 15px;
+    }
+
+    .ctrl-divider {
+        width: 1px;
+        height: 24px;
+        margin: 0 2px;
+    }
+
+    #title-bar {
+        top: 8px;
+        padding: 8px 16px;
+    }
+
+    #title-bar h1 {
+        font-size: 14px;
+    }
+}
+
+/* ============================================================================
+   节点图片区域（固定在面板顶部，不随内容滚动）
+   ============================================================================ */
+#info-panel .panel-image {
+    width: 100%;
+    height: 150px;
+    overflow: hidden;
+    flex-shrink: 0;
+    background: rgba(0,0,0,0.3);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    border-bottom: 1px solid var(--color-border);
+}
+
+.node-image {
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+    display: block;
+}
+
+.node-image-placeholder {
+    width: 100%;
+    height: 100%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.placeholder-flag svg {
+    max-width: 160px;
+    max-height: 100px;
+    opacity: 0.7;
+}
+
+/* ============================================================================
+   滚动条美化
+   ============================================================================ */
+::-webkit-scrollbar {
+    width: 4px;
+}
+
+::-webkit-scrollbar-track {
+    background: transparent;
+}
+
+::-webkit-scrollbar-thumb {
+    background: rgba(255,255,255,0.15);
+    border-radius: 2px;
+}
+
+::-webkit-scrollbar-thumb:hover {
+    background: rgba(255,255,255,0.25);
+}
+
+/* ============================================================================
+   节点标记样式 — 红一方面军军旗标记
+   ============================================================================ */
+.flag-marker-wrapper {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    cursor: pointer;
+    transition: transform 0.2s;
+}
+
+.flag-marker-wrapper:hover {
+    transform: scale(1.3);
+}
+
+.flag-marker-label {
+    font-size: 14px;
+    font-weight: 700;
+    color: #fff;
+    text-shadow:
+        0 0 3px rgba(0,0,0,0.9),
+        0 0 8px rgba(0,0,0,0.7),
+        1px 1px 1px rgba(0,0,0,0.8);
+    white-space: nowrap;
+    pointer-events: none;
+    line-height: 1.1;
+    margin-bottom: 1px;
+    letter-spacing: 0.5px;
+}
+
+.flag-marker-svg {
+    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
+    animation: flag-wave 3s ease-in-out infinite;
+    transform-origin: left center;
+}
+
+@keyframes flag-wave {
+    0%, 100% { transform: skewX(0deg); }
+    25% { transform: skewX(1.5deg); }
+    75% { transform: skewX(-1.5deg); }
+}
+
+.popup-mini {
+    min-width: 180px;
+    padding: 4px 0;
+}
+
+.popup-mini-title {
+    font-size: 14px;
+    font-weight: 600;
+    margin-bottom: 4px;
+    color: #333;
+}
+
+.popup-mini-sub {
+    font-size: 12px;
+    color: #888;
+    margin-bottom: 6px;
+}
+
+.popup-mini-hint {
+    font-size: 11px;
+    color: #c0392b;
+    font-weight: 500;
+}
+
+/* 节点选择下拉滚动 */
+#army-selector {
+    max-height: 400px;
+    overflow-y: auto;
+}
+#node-select-existing {
+    max-height: 300px;
+    overflow-y: auto;
+}
