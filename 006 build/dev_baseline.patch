+    /**
+     * 星火投稿的回调：将表单数据提交至 Spark API（含文件上传）
+     */
+    function sparkSubmitCallback(form, callType, mode, nodeId) {
+        var formData = new FormData(form);
+        var statusEl = document.getElementById("node-submit-status");
+        var submitBtn = document.getElementById("node-submit-btn");
+
+        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "提交中..."; }
+
+        // 补充既有节点模式：设置 target_node_id
+        var fdMode = mode === 'edit' ? 'update-node' : 'new-node';
+        formData.set('submission_type', fdMode);
+        if (mode === 'edit' && nodeId) {
+            formData.set('target_node_id', nodeId);
+        }
+
+        var fetchOpts = { method: "POST", body: formData };
+        if (window.authToken) {
+            fetchOpts.headers = { "Authorization": "Bearer " + window.authToken };
+        }
+
+        fetch("/api/v1/sparks/full", fetchOpts)
+            .then(function(r) { return r.json(); })
+            .then(function(json) {
+                if (json.code === 0) {
+                    statusEl.className = "form-status success";
+                    statusEl.textContent = "✅ 提交成功！等待管理员审核。";
+                    setTimeout(closeNodeEditor, 3000);
+                } else {
+                    statusEl.className = "form-status error";
+                    statusEl.textContent = "❌ " + (json.message || "提交失败");
+                }
+            })
+            .catch(function() {
+                statusEl.className = "form-status error";
+                statusEl.textContent = "❌ 网络错误，请重试";
+            })
+            .finally(function() {
+                if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "提交审核"; }
+            });
+    }
+
+    /**
+     * @brief 应用初始化入口
+     */
