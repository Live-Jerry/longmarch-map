+    <script src="/static/js/spark.js?v=20260716"></script>
+    {% include "_spark_modal.html" %}
+
+    <script>
+    // =========================================================================
+    // 节点管理
+    // 新增/编辑/查看通过 openNodeEditor() 打开共享节点编辑器，
+    // 提交回调直接把数据写入节点 API（JSON，非 FormData）
+    // =========================================================================
+
+    if (!localStorage.getItem("lm_token")) { location.href = "/login"; }
+
+    var currentPage = 1;
+
+    // ======================== 节点列表 ========================
+
+    async function loadNodes(page) {
+        if (page !== undefined) currentPage = page;
+        var token = localStorage.getItem("lm_token");
+        var search = document.getElementById("search-input").value.trim();
+        var url = "/api/v1/nodes?page=" + currentPage + "&per_page=20";
+        if (search) url += "&search=" + encodeURIComponent(search);
+
+        var resp = await fetch(url, { headers: { "Authorization": "Bearer " + token } });
+        var json = await resp.json();
+        var items = json.data?.items || [];
+        var total = json.data?.total || 0;
+        var pages = Math.ceil(total / 20);
+
+        var tbody = document.getElementById("nodes-tbody");
+        if (!items.length) {
+            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#95a5a6">暂无数据</td></tr>';
+        } else {
+            var html = "";
+            for (var i = 0; i < items.length; i++) {
+                var n = items[i];
+                html += '<tr>' +
+                    '<td>' + n.node_id + '</td>' +
+                    '<td><a href="javascript:openNodeEditor(\'查看\',\'' + n.node_id + '\', null)" style="color:#f39c12">' + n.title + '</a></td>' +
+                    '<td>' + n.location + '</td>' +
+                    '<td>' + n.time + '</td>' +
+                    '<td>' + parseFloat(n.lat).toFixed(2) + ", " + parseFloat(n.lng).toFixed(2) + '</td>' +
+                    '<td><span class="badge badge-' + (n.status || "active") + '">' + (n.status || "active") + '</span></td>' +
+                    '<td>' +
+                        '<a href="javascript:openNodeEditor(\'查看\',\'' + n.node_id + '\', null)" style="color:#95a5a6;margin-right:8px">查看</a>' +
+                        '<a href="javascript:openNodeEditor(\'编辑\',\'' + n.node_id + '\', adminEditCallback)" style="color:#3498db;margin-right:8px">编辑</a>' +
+                        '<a href="javascript:deleteNode(\'' + n.node_id + '\')" style="color:#e74c3c">删除</a>' +
+                    '</td>' +
+                '</tr>';
+            }
+            tbody.innerHTML = html;
+        }
+
+        var pg = document.getElementById("pagination");
+        var phtml = "";
+        for (var i = 1; i <= pages; i++) {
+            var bg = i === currentPage ? '#c0392b' : 'rgba(255,255,255,0.05)';
+            var cl = i === currentPage ? 'white' : '#95a5a6';
+            phtml += '<button onclick="loadNodes(' + i + ')" style="padding:6px 12px;border:1px solid rgba(255,255,255,0.1);border-radius:6px;background:' + bg + ';color:' + cl + ';cursor:pointer;font-size:12px">' + i + '</button>';
+        }
+        pg.innerHTML = phtml;
+    }
+
+    // ======================== 新增 / 编辑 回调（统一使用 FormData）========================
+
+    /**
+     * 新增节点回调：FormData → POST /api/v1/nodes（后端同时支持 JSON 和 multipart）
+     */
+    function adminAddCallback(form, callType, mode, nodeId) {
+        var formData = new FormData(form);
+        var statusEl = document.getElementById("node-submit-status");
+        var submitBtn = document.getElementById("node-submit-btn");
+
+        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "新增中..."; }
+
+        var token = localStorage.getItem("lm_token");
+        fetch("/api/v1/nodes", {
+            method: "POST",
+            headers: { "Authorization": "Bearer " + token },
+            body: formData,
+        })
+        .then(function(r) { return r.json(); })
+        .then(function(json) {
+            if (json.code === 0) {
+                statusEl.className = "form-status success";
+                statusEl.textContent = "✅ " + (json.message || "新增成功");
+                setTimeout(function() { closeNodeEditor(); loadNodes(1); }, 800);
+            } else {
+                statusEl.className = "form-status error";
+                statusEl.textContent = "❌ " + (json.message || "新增失败");
+            }
+        })
+        .catch(function() {
+            statusEl.className = "form-status error";
+            statusEl.textContent = "❌ 网络错误";
+        })
+        .finally(function() {
+            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "新增"; }
+        });
+    }
+
+    /**
+     * 编辑节点回调：FormData → PUT /api/v1/nodes/<id>
+     */
+    function adminEditCallback(form, callType, mode, nodeId) {
+        var formData = new FormData(form);
+        var statusEl = document.getElementById("node-submit-status");
+        var submitBtn = document.getElementById("node-submit-btn");
+
+        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "保存中..."; }
+
+        var token = localStorage.getItem("lm_token");
+        fetch("/api/v1/nodes/" + nodeId, {
+            method: "PUT",
+            headers: { "Authorization": "Bearer " + token },
+            body: formData,
+        })
+        .then(function(r) { return r.json(); })
+        .then(function(json) {
+            if (json.code === 0) {
+                statusEl.className = "form-status success";
+                statusEl.textContent = "✅ " + (json.message || "保存成功");
+                setTimeout(function() { closeNodeEditor(); loadNodes(1); }, 800);
+            } else {
+                statusEl.className = "form-status error";
+                statusEl.textContent = "❌ " + (json.message || "保存失败");
+            }
+        })
+        .catch(function() {
+            statusEl.className = "form-status error";
+            statusEl.textContent = "❌ 网络错误";
+        })
+        .finally(function() {
+            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "保存"; }
+        });
+    }
+
+    // ======================== 删除 / 导入 ========================
+
+    async function deleteNode(nodeId) {
+        if (!confirm("确认删除节点 " + nodeId + "？")) return;
+        var token = localStorage.getItem("lm_token");
+        var r = await fetch("/api/v1/nodes/" + nodeId, {
+            method: "DELETE",
+            headers: { "Authorization": "Bearer " + token },
+        });
+        var j = await r.json();
+        alert(j.message);
+        if (j.code === 0) loadNodes(currentPage);
+    }
+
+    async function importNodes() {
+        var path = prompt("请输入节点 JSON 文件路径（服务器端绝对路径）：");
+        if (!path) return;
+        var token = localStorage.getItem("lm_token");
+        var r = await fetch("/api/v1/nodes/import", {
+            method: "POST",
+            headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
+            body: JSON.stringify({ json_path: path }),
+        });
+        var j = await r.json();
+        alert("导入完成：新增 " + (j.data?.imported || 0) + "，跳过 " + (j.data?.skipped || 0));
+        if (j.code === 0) loadNodes(1);
+    }
+
+    loadNodes(1);
+    </script>
+</body>
+</html>
