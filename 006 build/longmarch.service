[Unit]
Description=Long March Map - Production (Gunicorn)
After=network.target
Before=longmarch-dev.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/longmarch-map/001 项目源码
Environment=FLASK_ENV=production
ExecStart=/opt/longmarch-map/venv/bin/gunicorn -c '/opt/longmarch-map/006 build/gunicorn_config.py' wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
